# SchoolGPT Environment Variables Configuration
# Copy this file to .env and adjust as needed

# Organization & App Branding
APP_NAME=SchoolGPT
APP_ORG=RSR Technologies
APP_TAGLINE=Smart • Reliable • Instant Answers
APP_ENV=development
DEBUG=True

# Database Configuration
DATABASE_PATH=data/schoolgpt.db
CHROMA_PERSIST_DIR=data/chroma_db
UPLOAD_DIR=data/uploads

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODELS=llama3.2:3b,mistral:7b,llama3:8b,gemma:7b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Embedding Configuration
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
EMBEDDING_DIMENSION=768
FALLBACK_EMBEDDINGS=true

# RAG Retrieval Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.35

# Multilingual Settings
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,kn,hi

# Security & Session
SESSION_TIMEOUT_MINUTES=120
SECRET_KEY=rsr-schoolgpt-secret-key-change-in-production
