# ==============================================================================
# SchoolGPT Environment Variables Configuration
# Organization: RSR Technologies
# Tagline: Smart • Reliable • Instant Answers
# ==============================================================================

# Application Branding
APP_NAME=SchoolGPT
ORG_NAME=RSR Technologies
TAGLINE=Smart. Reliable. Instant Answers.
ENVIRONMENT=development
VERSION=2.5.0

# Database Configuration (PostgreSQL on Render / SQLite for local)
# Local SQLite: sqlite:///./schoolgpt_backend.db
# Render PostgreSQL: postgresql://username:password@dpg-xxx.oregon-postgres.render.com/schoolgpt
DATABASE_URL=sqlite:///./schoolgpt_backend.db

# JWT & Authentication Security
SECRET_KEY=rsr-technologies-schoolgpt-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Dual AI Provider Configuration ('gemini' or 'ollama')
AI_PROVIDER=gemini

# Google Gemini API (Cloud Production)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Configuration (On-Premise / Local Development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe

# RAG & Vector Store
CHROMA_PERSIST_DIR=./data/chromadb
DOCUMENTS_DIR=./data/documents
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.40

# Multilingual Settings (en = English, kn = Kannada, hi = Hindi)
DEFAULT_LANGUAGE=en
