<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Web Content View -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:indeterminate="true"
        android:progressTint="#7C3AED"
        android:visibility="gone" />

    <!-- Offline / Error State Container -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="#FFFFFF"
        android:visibility="gone">

        <!-- Logo / Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎓"
            android:textSize="54sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SchoolGPT – LLM + RAG"
            android:textColor="#0B132B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RSR Technologies • Smart • Reliable • Instant Answers"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unable to reach the SchoolGPT server.\nVerify the server is running and accessible on your Wi-Fi or Cloud network."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="24dp" />

        <!-- Server Address Input -->
        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:hint="http://192.168.1.10:8000"
            android:inputType="textUri"
            android:layout_marginBottom="16dp" />

        <!-- Retry Button -->
        <Button
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Connect to Server 🚀"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_gradient"
            android:layout_marginBottom="10dp" />

        <!-- Reset to 192.168.1.10 Button -->
        <Button
            android:id="@+id/btnDefaultUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Use Hotspot IP (192.168.1.10:8000)"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="8dp" />

        <!-- Launch Embedded Offline App Button -->
        <Button
            android:id="@+id/btnOfflineMode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Launch Offline Embedded App ⚡"
            android:textColor="#4338CA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="8dp" />

        <!-- Auto Detect Server Button -->
        <Button
            android:id="@+id/btnAutoDetect"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Auto-Detect Hotspot Server 🔍"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:background="@android:color/transparent" />

    </LinearLayout>

</RelativeLayout>
